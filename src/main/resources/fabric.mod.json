{
	"schemaVersion": 1,
	"id": "aurorite",
	"version": "${version}",
	"name": "AuroriteClient",
	"description": "A lightweight Fabric client for Minecraft 26.3 with a frosted-glass ClickGUI, HUD modules, FreeLook, Zoom and more.",
	"authors": [
		"Cuteplayer647"
	],
	"contact": {
		"homepage": "https://github.com/Cuteplayer647/aurorite",
		"sources": "https://github.com/Cuteplayer647/aurorite",
		"issues": "https://github.com/Cuteplayer647/aurorite/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/aurorite/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cute.aurorite.Aurorite"
		],
		"client": [
			"com.cute.aurorite.client.AuroriteClient"
		]
	},
	"mixins": [
		{
			"config": "aurorite.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
